# Headless CMS or REST API origin, for example https://content.example.org
VITE_HEADLESS_API_URL=

# Public read and form routes relative to the API origin
VITE_PROGRAMS_API_PATH=/api/programs
VITE_INQUIRIES_API_PATH=/api/inquiries

# Optional browser-safe public token only. Never put a private API key here.
VITE_HEADLESS_PUBLIC_TOKEN=
